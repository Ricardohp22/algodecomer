# Copia este archivo a .env en la raíz del repositorio.
# Postgres.app en este equipo escucha en 5432.
# Docker Compose publica PostGIS en 5433 para convivir con Postgres.app:
# postgres://algodecomer:algodecomer@localhost:5433/algodecomer

NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

DATABASE_URL=postgres://algodecomer:algodecomer@localhost:5432/algodecomer
DATABASE_SSL=disable
DATABASE_POOL_MAX=10

APP_TIMEZONE=America/Mexico_City
ORDER_ACCEPTANCE_TIMEOUT_SECONDS=300

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio12345
MINIO_BUCKET=algodecomer

# Secretos locales. En producción hay que cambiarlos; si se omiten, el entorno de desarrollo usa valores fijos.
COOKIE_SECRET=dev-only-cookie-secret
OTP_PEPPER=dev-only-otp-pepper-01
MEDIA_SIGNING_SECRET=dev-only-media-secret
# UPLOAD_DIR=data/uploads
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
